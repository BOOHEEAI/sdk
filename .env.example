# 薄荷开放平台 API 凭证
# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# Access Token 模式
BOOHEE_APP_ID=your_app_id
BOOHEE_APP_KEY=your_app_key
BOOHEE_PRIVATE_KEY_PATH=./private.pem

# API Key 模式
BOOHEE_API_KEY=your_api_key

# 可选：自定义 base_url（默认 https://api.boohee.com）
# BOOHEE_BASE_URL=https://api.boohee.com
